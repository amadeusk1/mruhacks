; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Pengloo Party"
config/icon="res://ui/branding/pengloo-party-icon.png"
boot_splash/image="res://ui/branding/pengloo-party-logo.png"
boot_splash/bg_color=Color(0.035, 0.13, 0.23, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true
run/main_scene="res://scenes/startup.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true
driver/output_latency.web=100

[autoload]

Net="*res://scripts/net.gd"
AssetRegistry="*res://scripts/assets/asset_registry.gd"
Activities="*res://scripts/world/activities.gd"
SketchClub="*res://scripts/activities/sketch_club.gd"
UIRouter="*res://ui/ui_router.gd"
ActivityScreens="*res://ui/activities/activity_screens.gd"
Music="*res://scripts/music.gd"
CinemaService="*res://scripts/cinema/cinema_service.gd"
Voice="*res://scripts/voice/voice.gd"
SledRace="*res://scripts/activities/sled_race.gd"
ArcadeNet="*res://scripts/activities/arcade_net.gd"
Casino="*res://scripts/casino/casino.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme/pengloo_theme.tres"

