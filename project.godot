[layer_names]

3d_physics/layer_1="floor"
3d_physics/layer_2="blockers"
3d_physics/layer_3="penguin"
3d_physics/layer_4="hazards"

[shader_globals]

occlusion_target={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
occlusion_radius={
"type": "float",
"value": 0.0
}

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[navigation]

world/map_use_async_iterations=false
world/region_use_async_iterations=false

[pengloo]

cinema/service_enabled=true
cinema/service_url="https://pengloo.party/cinema/"
cinema/watch_overlay=true
cinema/screen_video=true
cinema/ambience=true
